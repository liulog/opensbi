<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="mpt-privilege" name="MPT DEMO · 特权级职责与接口">
    <mxGraphModel dx="1640" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1240" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="MPT DEMO｜各特权级做什么？" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="S-mode 发起策略配置 → M-mode 管理表并写 CSR → NEMU 模拟硬件执行权限检查" style="text;html=1;align=left;fontSize=17;fontColor=#526375;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="30" as="geometry"/></mxCell>

        <mxCell id="u-lane" value="U-mode｜用户态：验证 Linux 已完成启动" style="swimlane;html=1;startSize=40;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#d5e8d4;swimlaneFillColor=#f7fbf6;strokeColor=#82b366;fontSize=18;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1040" height="160" as="geometry"/></mxCell>
        <mxCell id="u-note" value="不直接调用本 DEMO 的 SBI 接口&lt;br&gt;不持有 MPT 表，也不能写 mmpt CSR" style="text;html=1;align=left;whiteSpace=wrap;fontSize=17;fontColor=#426040;" vertex="1" parent="u-lane"><mxGeometry x="60" y="65" width="440" height="70" as="geometry"/></mxCell>
        <mxCell id="u-init" value="&lt;b&gt;极小 initramfs：/init&lt;/b&gt;&lt;br&gt;通过 /dev/kmsg 输出 PASS&lt;br&gt;执行 NEMU 退出指令，结束验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;spacing=10;" vertex="1" parent="u-lane"><mxGeometry x="620" y="55" width="350" height="90" as="geometry"/></mxCell>

        <mxCell id="s-lane" value="S-mode｜监督态：调用 SBI、测试权限、运行 Linux" style="swimlane;html=1;startSize=40;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#dae8fc;swimlaneFillColor=#f7faff;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1040" height="230" as="geometry"/></mxCell>
        <mxCell id="s-shim" value="&lt;b&gt;启动测试 shim（新增）&lt;/b&gt;&lt;br&gt;① RESET / SET / GET 配置并检查表&lt;br&gt;② ENABLE 后实测读、写、取指&lt;br&gt;③ 捕获访问异常，核对 scause / stval&lt;br&gt;④ 恢复全 RWX，开启 MPT 后进入 Linux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=17;spacing=10;" vertex="1" parent="s-lane"><mxGeometry x="60" y="65" width="420" height="145" as="geometry"/></mxCell>
        <mxCell id="s-linux" value="&lt;b&gt;Linux Image（原样复用）&lt;/b&gt;&lt;br&gt;自身不主动调用新 MPT 接口&lt;br&gt;在 MPT 全 RWX 策略下启动&lt;br&gt;使用原有内核页表，最终运行 /init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=17;spacing=10;" vertex="1" parent="s-lane"><mxGeometry x="620" y="65" width="350" height="145" as="geometry"/></mxCell>

        <mxCell id="m-lane" value="M-mode｜OpenSBI" style="swimlane;html=1;startSize=40;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#e1d5e7;swimlaneFillColor=#fbf8fc;strokeColor=#9673a6;fontSize=18;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1040" height="220" as="geometry"/></mxCell>
        <mxCell id="m-api" value="&lt;b&gt;实验性 SBI 分发器&lt;/b&gt;&lt;br&gt;EID = 0x084d5054&lt;br&gt;root domain / 非 VS 调用检查&lt;br&gt;参数、状态与地址校验&lt;br&gt;返回 error / value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=16;spacing=10;" vertex="1" parent="m-lane"><mxGeometry x="60" y="65" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="m-table" value="&lt;b&gt;表管理 + 固件内表池&lt;/b&gt;&lt;br&gt;32 × 4 KiB = 128 KiB&lt;br&gt;三级表，按需拆分到 4 KiB&lt;br&gt;RESET 回收；SET / GET 权限&lt;br&gt;表位于 BSS，由现有 PMP 保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=16;spacing=10;" vertex="1" parent="m-lane"><mxGeometry x="450" y="65" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="m-csr" value="&lt;b&gt;mmpt CSR&lt;/b&gt;&lt;br&gt;地址 0x382&lt;br&gt;ENABLE：MODE=1&lt;br&gt;写根表 PPN&lt;br&gt;DISABLE：写 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=16;spacing=10;" vertex="1" parent="m-lane"><mxGeometry x="820" y="65" width="190" height="135" as="geometry"/></mxCell>

        <mxCell id="hw-lane" value="NEMU 模拟硬件｜不属于某个软件特权级" style="swimlane;html=1;startSize=40;horizontal=1;container=1;collapsible=0;pointerEvents=0;fillColor=#fff2cc;swimlaneFillColor=#fffdf6;strokeColor=#d6b656;fontSize=18;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1040" height="190" as="geometry"/></mxCell>
        <mxCell id="hw-walk" value="&lt;b&gt;对 S/U 有效特权的物理访问实施 MPT 检查&lt;/b&gt;&lt;br&gt;从 mmpt 找到根表 → walk → 读取目标页的 R / W / X&lt;br&gt;正常 M-mode 访问绕过 MPT；MPRV 按有效特权判断&lt;br&gt;写 mmpt 会刷新 NEMU 地址翻译缓存；PMP/PMA 仍独立生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=16;spacing=10;" vertex="1" parent="hw-lane"><mxGeometry x="60" y="60" width="650" height="110" as="geometry"/></mxCell>
        <mxCell id="hw-outcome" value="&lt;b&gt;检查结果&lt;/b&gt;&lt;br&gt;允许：继续访问&lt;br&gt;拒绝：访问异常&lt;br&gt;shim 验证拒绝行为" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=16;spacing=10;" vertex="1" parent="hw-lane"><mxGeometry x="800" y="60" width="210" height="110" as="geometry"/></mxCell>

        <mxCell id="edge-linux-user" value="运行用户程序" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="s-linux" target="u-init"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-shim-linux" value="测试后跳转" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s-shim" target="s-linux"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-ecall" value="ecall：a7=EID，a6=FID，a0/a1=参数" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.3452380952;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-shim" target="m-api"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-manage" value="管理表" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m-api" target="m-table"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-config" value="发布" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#9673a6;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="m-table" target="m-csr"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-root" value="根表与开关" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b38b22;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.9230769231;entryY=0;" edge="1" parent="1" source="m-csr" target="hw-walk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="910"/><mxPoint x="700" y="910"/></Array><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-walk-table" value="硬件读取表项" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;strokeColor=#b38b22;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.7538461538;exitY=0;entryX=0.3333333333;entryY=1;" edge="1" parent="1" source="hw-walk" target="m-table"><mxGeometry relative="1" as="geometry"><mxPoint x="-70" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="edge-result" value="RWX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b38b22;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hw-walk" target="hw-outcome"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>

        <mxCell id="api-title" value="&lt;b&gt;实验性 SBI 接口&lt;/b&gt;&lt;br&gt;EID = 0x084d5054" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172B4D;strokeColor=#172B4D;fontColor=#ffffff;fontSize=23;spacing=15;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="470" height="100" as="geometry"/></mxCell>
        <mxCell id="api-list" value="&lt;b&gt;FID 0 · RESET(default_perm)&lt;/b&gt;&lt;br&gt;初始化 / 清空表，回收表池&lt;br&gt;&lt;br&gt;&lt;b&gt;FID 1 · SET_PAGE(pa, perm)&lt;/b&gt;&lt;br&gt;设置一个 4 KiB 物理页的权限&lt;br&gt;&lt;br&gt;&lt;b&gt;FID 2 · GET_PAGE(pa)&lt;/b&gt;&lt;br&gt;返回该页的 MPT 权限&lt;br&gt;&lt;br&gt;&lt;b&gt;FID 3 · ENABLE()&lt;/b&gt;&lt;br&gt;发布根表，启用 MPT&lt;br&gt;&lt;br&gt;&lt;b&gt;FID 4 · DISABLE()&lt;/b&gt;&lt;br&gt;关闭 MPT，保留表内容&lt;br&gt;&lt;br&gt;&lt;b&gt;FID 5 · STATUS()&lt;/b&gt;&lt;br&gt;bit0 = 已初始化；bit1 = 已启用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#ccd5df;fontSize=18;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1"><mxGeometry x="1120" y="240" width="470" height="510" as="geometry"/></mxCell>
        <mxCell id="abi-note" value="&lt;b&gt;调用约定与权限&lt;/b&gt;&lt;br&gt;a7 = EID；a6 = FID&lt;br&gt;返回：a0 = error；a1 = value&lt;br&gt;R=1 / W=2 / X=4；0=拒绝，7=全允许&lt;br&gt;pa：4 KiB 对齐，且 pa &amp;lt; 2^43" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#ccd5df;fontSize=17;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="1120" y="770" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="limits-note" value="&lt;b&gt;DEMO 边界&lt;/b&gt;&lt;br&gt;默认关闭，手动启用 Kconfig 选项&lt;br&gt;仅单 hart RV64；模式 1；不支持 VS&lt;br&gt;RESET / SET 必须在 MPT 关闭时执行&lt;br&gt;S-mode 可禁用 MPT：不是恶意 S-mode 隔离&lt;br&gt;&lt;br&gt;&lt;b&gt;已验证&lt;/b&gt;：183 项断言 + Linux 用户态启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#ccd5df;fontSize=16;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="1120" y="950" width="470" height="210" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例：绿色 U-mode · 蓝色 S-mode · 紫色 M-mode · 黄色 NEMU 硬件模型；实线为控制/启动路径，虚线为查表读取。" style="text;html=1;align=left;fontSize=15;fontColor=#526375;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1550" height="25" as="geometry"/></mxCell>
        <mxCell id="provenance" value="依据：lib/sbi/sbi_ecall_mpt.c · include/sbi/sbi_ecall_mpt.h · tests/mpt/ · ../NEMU/src/isa/riscv64/system/mmu.c" style="text;html=1;align=left;fontSize=12;fontColor=#778594;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="1550" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
